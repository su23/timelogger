CREATE TABLE ActiveTimer (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    activity_id INTEGER NOT NULL UNIQUE REFERENCES Activity(id) ON DELETE CASCADE,
    start_time INTEGER NOT NULL,
    accumulated_ms INTEGER NOT NULL DEFAULT 0,
    is_paused INTEGER NOT NULL DEFAULT 0,
    paused_at INTEGER,
    target_duration_ms INTEGER
);

selectAll:
SELECT * FROM ActiveTimer;

selectByActivityId:
SELECT * FROM ActiveTimer WHERE activity_id = ?;

insert:
INSERT INTO ActiveTimer(activity_id, start_time, accumulated_ms, is_paused, paused_at, target_duration_ms)
VALUES (?, ?, ?, ?, ?, ?);

update:
UPDATE ActiveTimer SET start_time = ?, accumulated_ms = ?, is_paused = ?, paused_at = ?, target_duration_ms = ? WHERE id = ?;

deleteById:
DELETE FROM ActiveTimer WHERE id = ?;

deleteByActivityId:
DELETE FROM ActiveTimer WHERE activity_id = ?;

deleteAll:
DELETE FROM ActiveTimer;
